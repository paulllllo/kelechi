# Optional — only needed for the Spotify "now playing" widget.
# See server/index.js for the one-time setup flow.
PORT=8787
CORS_ORIGIN=http://localhost:5173

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Spotify rejects "localhost". Use the loopback IP, and register the same URI on the app.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/spotify/callback
