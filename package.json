{
  "name": "kelechi-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node api.js && vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "build": "node api.js && tsc --noEmit && vite build",
